    },
    "Le remplacement de l'app a échoué : ta version actuelle reste en place." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replacing the app failed: your current version stays in place."
          }
        }
      }
    },
    "Wispad est à jour mais n'a pas pu se relancer : quitte-le, puis rouvre-le." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wispad is up to date but couldn't relaunch: quit it, then open it again."
          }
        }
      }
    },
    "Un autre Wispad ouvert installe déjà une mise à jour : réessaie quand il aura fini." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another open Wispad is already installing an update: try again once it's done."
          }
        }
      }
    },
    "Wispad ne peut pas se remplacer là où il est installé : la nouvelle version se télécharge depuis la page de la release." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wispad can't replace itself where it's installed: download the new version from the release page."
          }
        }
      }
    },
    "Cette version s'installe depuis la page de la release." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version installs from the release page."
          }
        }
      }
    },
    "À la fin de la dictée, l'enregistrement complet est transcrit une seconde fois et comparé au texte reçu en direct." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the dictation ends, the full recording is transcribed a second time and compared with the live text."
          }
        }
      }
    },
