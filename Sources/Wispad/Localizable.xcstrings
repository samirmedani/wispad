            "value" : "With their symbol, or spelled out."
          }
        }
      }
    },
    "Symboles : « vingt-cinq euros » devient « 25 € », « cinq kilomètres » devient « 5 km », « quinze pour cent » devient « 15 % »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbols: “twenty-five euros” becomes “€25”, “five kilometers” becomes “5 km”, “fifteen percent” becomes “15%”."
          }
        }
      }
    },
    "En toutes lettres : « 25 euros », « 5 kilomètres ». Le pourcentage garde toujours « % »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelled out: “25 euros”, “5 kilometers”. Percentages always keep “%”."
          }
        }
      }
    },
    "Un montant ou une mesure déjà en chiffres prend aussi ce format. Années, codes postaux, références et numéros de version ne changent jamais." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An amount or a measurement already in digits takes this format too. Years, zip codes, references and version numbers never change."
          }
        }
      }
    },
    "Les numéros de téléphone français s'écrivent par paires : « 06 12 34 56 78 », « +33 6 12 34 56 78 »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "French phone numbers are written in pairs: “06 12 34 56 78”, “+33 6 12 34 56 78”."
          }
        }
      }
    },
