      }
    },
    "Le suivi commence avec cette mise à jour. Les anciennes durées ne peuvent pas être reconstituées." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracking starts with this update. Earlier durations can't be rebuilt."
          }
        }
      }
    },
    "Le temps économisé compare la dictée à une frappe à %lld mots par minute." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time saved compares dictation with typing at %lld words per minute."
          }
        }
      }
    },
    "le texte transcrit est inséré tel quel" : {
      "localizations" : {
        "en" : {
