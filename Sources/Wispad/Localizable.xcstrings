            "value" : "the transcribed text is inserted as is"
          }
        }
      }
    },
    "le texte transcrit est utilisé avec les seules commandes explicites de mise en page" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the transcribed text is used with only the explicit layout commands"
          }
        }
      }
    },
    "Lecture impossible." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't play."
          }
        }
      }
    },
    "Les commandes explicites « première puce », « deuxième puce » et « nouveau paragraphe » fonctionnent localement. Pour structurer une dictée naturelle, active la correction avec un fournisseur configuré." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The explicit commands “first bullet”, “second bullet” and “new paragraph” work locally. To structure natural dictation, turn on correction with a configured provider."
          }
        }
      }
    },
    "Les montants précédés de ≥ sont des minimums : le coût de certains appels est inconnu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amounts marked ≥ are minimums: some calls have an unknown cost."
          }
        }
      }
    },
