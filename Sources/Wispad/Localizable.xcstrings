    "La signature de cette version n'est pas celle de Wispad : rien n'a été installé." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version isn't signed by Wispad's developer: nothing was installed."
