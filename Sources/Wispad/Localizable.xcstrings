            "state" : "translated",
            "value" : "Separator for large numbers."
          }
        }
      }
    },
    "Selon la langue : « 12 500 » en français, avec une espace qui ne coupe jamais le nombre en fin de ligne ; « 12,500 » en anglais." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By language: “12 500” in French, with a space that never breaks the number at the end of a line; “12,500” in English."
          }
        }
      }
    },
    "Les fiches techniques gardent leurs chiffres collés : « 6000 MHz », « 1024 Go »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
