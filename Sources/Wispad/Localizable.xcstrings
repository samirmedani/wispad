            "state" : "translated",
            "value" : "Help"
          }
        }
      }
    },
    "Mise en forme" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formatting"
          }
        }
      }
    },
    "Dates" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dates"
          }
        }
      }
    },
    "Ordre du jour, du mois et de l'année." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Order of the day, the month and the year."
          }
        }
      }
    },
    "Une date dite s'écrit dans ce format quand le contexte la rend évidente : « le vingt-quatre octobre deux mille vingt-six » devient « 24/10/2026 »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A spoken date is written in this format when the context makes it obvious: “October twenty-fourth twenty twenty-six” becomes “24/10/2026”."
          }
        }
      }
    },
    "Sans année dite, la date reste sans année : « le trois novembre » devient « 03/11 ». Un jour seul, comme « mardi », reste en lettres." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a spoken year, the date stays without a year: “November third” becomes “03/11”. A weekday alone, like “Tuesday”, stays in words."
          }
        }
      }
    },
    "Une date déjà écrite en chiffres prend aussi ce format, même si le service de correction l'a écrite autrement." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A date already written in digits also takes this format, even if the correction service wrote it differently."
          }
        }
      }
    },
    "Séparateur" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separator"
          }
        }
      }
    },
    "Signe entre le jour, le mois et l'année." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign between the day, the month and the year."
          }
        }
      }
    },
    "Année" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Year"
          }
        }
      }
    },
    "Année complète, ou ses deux derniers chiffres seulement." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full year, or only its last two digits."
          }
        }
      }
    },
    "Zéro initial" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leading zero"
          }
        }
      }
    },
    "Jour et mois toujours sur deux chiffres." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Day and month always written with two digits."
          }
        }
      }
    },
    "Activé : « 03/11 ». Désactivé : « 3/11 »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On: “03/11”. Off: “3/11”."
          }
        }
      }
    },
    "Garder les dates en toutes lettres" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep dates in words"
          }
        }
      }
    },
    "Mois en lettres, jour et année en chiffres." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Month in words, day and year in digits."
          }
        }
      }
    },
    "« 24 octobre 2026 » plutôt que « 24/10/2026 », « 3 novembre » plutôt que « 03/11 »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“24 October 2026” rather than “24/10/2026”, “3 November” rather than “03/11”."
          }
        }
      }
    },
    "En anglais, l'ordre choisi décide entre « October 24, 2026 » et « 24 October 2026 »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In English, the chosen order decides between “October 24, 2026” and “24 October 2026”."
          }
        }
      }
    },
    "Heures" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clock"
          }
        }
      }
    },
    "Selon la langue : sur vingt-quatre heures en français, AM/PM en anglais." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By language: twenty-four-hour clock in French, AM/PM in English."
          }
        }
      }
    },
    "Une durée reste une durée : « deux heures de route » devient « 2 heures de route »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A duration stays a duration: “two hours of driving” becomes “2 hours of driving”."
          }
        }
      }
    },
    "Sur 12 h, une heure déjà en chiffres sans matin ni soir (« à 9 h ») reste telle quelle : elle pourrait être l'une ou l'autre." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
