        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. Audio goes to %2$@; if it doesn't respond and a key for the other provider is saved, the same recording goes there instead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. L'audio part chez %2$@ ; s'il ne répond pas et qu'une clé de l'autre fournisseur est enregistrée, le même enregistrement part chez celui-ci."
